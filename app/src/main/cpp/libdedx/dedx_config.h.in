// Data paths configured by CMake at build time
#define DEDX_DATA_PATH "@DEDX_DATA_PATH@"
#define DEDX_DATA_PATH_LOCAL "@DEDX_DATA_PATH_LOCAL@"

// Version fallbacks — Android build does not use dedx_get_version(), see dEdx.c
#ifndef DEDX_VERSION_MAJOR
#define DEDX_VERSION_MAJOR 0
#endif
#ifndef DEDX_VERSION_MINOR
#define DEDX_VERSION_MINOR 0
#endif
#ifndef DEDX_VERSION_PATCH
#define DEDX_VERSION_PATCH 0
#endif
